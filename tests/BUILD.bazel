load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_test(
    name = "scrim_integration_test",
    srcs = ["integration_test.rs"],
    edition = "2021",
    data = ["//src/bin:scrim"],
    # Run tests serially to prevent race conditions across tests that access
    # the shared telemetry log file at /tmp/scrim_telemetry.log.
    # TODO: Support configuring the telemetry log path so each test can use an
    # isolated log file and run concurrently.
    env = {
        "RUST_TEST_THREADS": "1",
    },
    deps = [
        ":test_helpers",
        "//src/version",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "performance_validation_test",
    srcs = ["perf_test.rs"],
    edition = "2021",
    data = ["//benches:scrim_bench"],
    tags = ["manual"],
    deps = ["@crates//:tempfile"],
)

rust_library(
    name = "test_helpers",
    testonly = True,
    srcs = ["test_helpers.rs"],
    crate_root = "test_helpers.rs",
    edition = "2021",
    visibility = ["//src/fetcher:__pkg__"],
    deps = [
        "@crates//:backhand",
    ],
)

rust_test(
    name = "test_helpers_test",
    crate = ":test_helpers",
    deps = [
        "@crates//:tempfile",
    ],
)

