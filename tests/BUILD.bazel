load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_test(
    name = "scrim_integration_test",
    srcs = ["integration_test.rs"],
    edition = "2021",
    data = ["//src/bin:scrim"],
    deps = [
        ":test_helpers",
        "//src/version",
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "performance_validation_test",
    srcs = ["perf_test.rs"],
    edition = "2021",
    data = ["//benches:scrim_bench"],
    tags = [
        "exclusive",
        "manual",
    ],
    deps = [
        ":test_helpers",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "test_helpers",
    testonly = True,
    srcs = ["test_helpers.rs"],
    crate_root = "test_helpers.rs",
    edition = "2021",
    visibility = [
        "//benches:__pkg__",
        "//src/fetcher:__pkg__",
    ],
    deps = [
        "@crates//:backhand",
        "@crates//:rustls",
        "@crates//:rustls-pki-types",
    ],
)

rust_test(
    name = "test_helpers_test",
    srcs = ["test_helpers_test.rs"],
    edition = "2021",
    deps = [
        ":test_helpers",
        "@crates//:backhand",
        "@crates//:tempfile",
        "@crates//:ureq",
    ],
)

