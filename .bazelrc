# Do not discover local toolchains
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Default build target platform inherits host OS/CPU with musl static linking
build --platforms=//:musl_host
test --platforms=@platforms//host

# Platform configs
build:linux-x86_64 --platforms=//:x86_64-unknown-linux-musl
build:linux-aarch64 --platforms=//:aarch64-unknown-linux-musl

# Configure workspace status script for binary stamping
build --workspace_status_command=tools/workspace_status.sh
