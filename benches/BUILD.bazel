load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "scrim_bench",
    testonly = True,
    srcs = ["bench.rs"],
    edition = "2021",
    rustc_flags = select({
        "@llvm//platforms/config:musl": ["-C", "relocation-model=static"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    data = ["//src/bin:scrim"],
    deps = [
        "//src/config",
        "//src/resolver",
        "//tests:test_helpers",
        "@crates//:criterion",
        "@crates//:tempfile",
    ],
)
