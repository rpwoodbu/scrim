load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "scrim",
    srcs = ["main.rs"],
    edition = "2021",
    rustc_env = {
        "SCRIM_GIT_COMMIT": "{STABLE_GIT_COMMIT}",
    },
    rustc_flags = select({
        "//:musl": ["-C", "relocation-model=static"],
        "//conditions:default": [],
    }),
    stamp = -1,
    visibility = ["//visibility:public"],
    deps = [
        "//src/cli",
        "//src/config",
        "//src/fetcher",
        "//src/linker",
        "//src/logger",
        "//src/resolver",
        "//src/telemetry",
        "//src/version",
        "@crates//:libc",
        "@crates//:serde_yaml",
    ],
)
