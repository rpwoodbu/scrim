load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "fetcher",
    srcs = ["fetcher.rs"],
    crate_root = "fetcher.rs",
    edition = "2021",
    visibility = ["//src/bin:__pkg__"],
    deps = [
        ":archive",
        ":hashing",
        "//src/logger",
        "@crates//:tempfile",
        "@crates//:ureq",
    ],
)

rust_test(
    name = "fetcher_test",
    crate = ":fetcher",
    deps = [
        "//tests:test_helpers",
        "@crates//:flate2",
        "@crates//:lzma-rs",
        "@crates//:sha2",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:zip",
    ],
)

rust_library(
    name = "archive",
    srcs = ["archive.rs"],
    crate_root = "archive.rs",
    edition = "2021",
    deps = [
        ":appimage",
        "@crates//:flate2",
        "@crates//:lzma-rs",
        "@crates//:tar",
        "@crates//:tempfile",
        "@crates//:zip",
    ],
)

rust_test(
    name = "archive_test",
    crate = ":archive",
    deps = [
        "//tests:test_helpers",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "hashing",
    srcs = ["hashing.rs"],
    crate_root = "hashing.rs",
    edition = "2021",
    deps = [
        "@crates//:sha2",
    ],
)

rust_test(
    name = "hashing_test",
    crate = ":hashing",
)

rust_library(
    name = "appimage",
    srcs = ["appimage.rs"],
    crate_root = "appimage.rs",
    edition = "2021",
    deps = [
        ":elf",
        "@crates//:backhand",
    ],
)

rust_test(
    name = "appimage_test",
    crate = ":appimage",
    deps = [
        "//tests:test_helpers",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "elf",
    srcs = ["elf.rs"],
    crate_root = "elf.rs",
    edition = "2021",
)

rust_test(
    name = "elf_test",
    crate = ":elf",
    deps = [
        "//tests:test_helpers",
    ],
)




