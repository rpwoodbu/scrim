load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "config",
    srcs = ["config.rs"],
    crate_root = "config.rs",
    edition = "2021",
    visibility = [
        "//src/bin:__pkg__",
        "//src/linker:__pkg__",
        "//src/resolver:__pkg__",
        "//benches:__pkg__",
    ],
    deps = [
        ":cache",
        ":platform",
        "//src/logger",
        "//src/version",
        "@crates//:serde",
        "@crates//:serde_with",
        "@crates//:serde_yaml",
    ],
)

rust_test(
    name = "config_test",
    srcs = ["config_test.rs"],
    edition = "2021",
    deps = [
        ":config",
        "@crates//:serde_yaml",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "cache",
    srcs = ["cache.rs"],
    crate_root = "cache.rs",
    edition = "2021",
    visibility = [
        "//src/bin:__pkg__",
        "//src/config:__pkg__",
        "//tests:__pkg__",
    ],
    deps = [
        "//src/version",
        "@crates//:bincode",
        "@crates//:serde",
        "@crates//:sha2",
    ],
)

rust_test(
    name = "cache_test",
    srcs = ["cache_test.rs"],
    edition = "2021",
    deps = [
        ":cache",
        "//src/version",
        "@crates//:bincode",
        "@crates//:tempfile",
    ],
)

rust_library(
    name = "platform",
    srcs = ["platform.rs"],
    crate_root = "platform.rs",
    edition = "2021",
    deps = [
        "@crates//:serde",
    ],
)

rust_test(
    name = "platform_test",
    crate = ":platform",
)
